# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# =========================================================================
# RAZORPAY PAYMENT GATEWAY ENVIRONMENT VARIABLES (SERVER-SIDE ONLY)
# =========================================================================
# 1. Razorpay Key ID (public key identifier)
#    - For Test Mode: starts with "rzp_test_..."
#    - For Live Mode: starts with "rzp_live_..."
RAZORPAY_KEY_ID=your_razorpay_key_id

# 2. Razorpay Key Secret (private server-side secret key)
#    - NEVER expose this key to React or the browser.
#    - Must match the corresponding Test or Live Key ID from Razorpay Dashboard.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 3. Razorpay Webhook Secret (optional, used for webhook verification)
#    - Used strictly for verifying Razorpay webhook event signatures.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret


