# =========================================================================
# SBM HOTEL & GUEST HOUSE — MULTI-PROPERTY PAYMENT GATEWAY CONFIGURATION
# =========================================================================
# This file serves as a template for server-side environment variables.
# NEVER commit actual API keys or secret credentials to source control.
# Set these variables in your deployment platform environment settings
# (e.g., Cloud Run environment variables, Coolify, Vercel, or server .env).

# -------------------------------------------------------------------------
# GLOBAL APPLICATION SETTINGS
# -------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="https://sbmhotel.com"
NODE_ENV="production" # Set to "production" to enforce strict credential validation and disable simulation fallbacks
ALLOW_PAYMENT_SIMULATION="false" # Set to "true" ONLY in local development/sandbox testing

# -------------------------------------------------------------------------
# SBM 1: SBM HOTEL (Main Property) — EASEBUZZ HOSTED CHECKOUT
# -------------------------------------------------------------------------
# SBM 1 routes exclusively to Easebuzz Standard Hosted Checkout.
# Official docs: https://docs.easebuzz.in/
SBM1_PAYMENT_GATEWAY_PROVIDER=easebuzz
SBM1_GATEWAY_KEY_ID=your_easebuzz_merchant_key_here
SBM1_GATEWAY_KEY_SECRET=your_easebuzz_merchant_salt_here
SBM1_EASEBUZZ_ENV=test # Options: test (https://testpay.easebuzz.in) | live (https://pay.easebuzz.in)
SBM1_BANK_ACCOUNT_NAME="SBM Hotel Salasar"

# Easebuzz Hosted Checkout Callback URL:
# ${APP_URL}/api/payments/easebuzz/callback (auto-passed as return_url/callback)

# -------------------------------------------------------------------------
# SBM 2: SBM 2 GUEST HOUSE (Secondary Property) — PHONEPE CHECKOUT SDK
# -------------------------------------------------------------------------
# SBM 2 routes exclusively to PhonePe Standard Checkout SDK.
# Official docs: https://developer.phonepe.com/
SBM2_PAYMENT_GATEWAY_PROVIDER=phonepe
SBM2_GATEWAY_KEY_ID=your_phonepe_client_or_merchant_id_here
SBM2_GATEWAY_KEY_SECRET=your_phonepe_client_secret_here
SBM2_PHONEPE_CLIENT_ID=your_phonepe_client_or_merchant_id_here
SBM2_PHONEPE_CLIENT_SECRET=your_phonepe_client_secret_here
SBM2_PHONEPE_CLIENT_VERSION=1
SBM2_PHONEPE_ENV=PRODUCTION # Options: PRODUCTION | SANDBOX
SBM2_PHONEPE_WEBHOOK_USERNAME=your_phonepe_webhook_username_here
SBM2_PHONEPE_WEBHOOK_PASSWORD=your_phonepe_webhook_password_here
SBM2_BANK_ACCOUNT_NAME="SBM 2 Guest House"

# PhonePe Webhook URL:
# ${APP_URL}/api/payments/webhook/sbm-guest-house

# =========================================================================
# EMAIL & WHATSAPP NOTIFICATIONS (SERVER-SIDE ONLY)
# =========================================================================
EMAIL_HOST=sbmhotel.com
EMAIL_PORT=587
EMAIL_USER=bookings@sbmhotel.com
EMAIL_PASSWORD=your_cyberpanel_mailbox_password
EMAIL_FROM=bookings@sbmhotel.com
ADMIN_EMAIL=sbmhotel@gmail.com

BHASHSMS_API_URL=https://api.bhashsms.com/api/v1/whatsapp/send
BHASHSMS_SENDER_ID=SBMHTL
BHASHSMS_API_KEY=your_bhashsms_api_key
BHASHSMS_OTP_TEMPLATE_ID=sbm_login_otp_v1
BHASHSMS_BOOKING_TEMPLATE_ID=sbm_booking_confirmation_v1
