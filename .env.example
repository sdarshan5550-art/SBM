# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# =========================================================================
# RAZORPAY PAYMENT GATEWAY ENVIRONMENT VARIABLES (SERVER-SIDE ONLY)
# =========================================================================
# 1. Razorpay Key ID (public key identifier)
#    - For Test Mode: starts with "rzp_test_..."
#    - For Live Mode: starts with "rzp_live_..."
RAZORPAY_KEY_ID=your_razorpay_key_id

# 2. Razorpay Key Secret (private server-side secret key)
#    - NEVER expose this key to React or the browser.
#    - Must match the corresponding Test or Live Key ID from Razorpay Dashboard.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 3. Razorpay Webhook Secret (optional, used for webhook verification)
#    - Used strictly for verifying Razorpay webhook event signatures.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# =========================================================================
# EMAIL NOTIFICATION SYSTEM ENVIRONMENT VARIABLES (SERVER-SIDE ONLY)
# =========================================================================
# CyberPanel SMTP server host (sbmhotel.com or mail server hostname)
EMAIL_HOST=sbmhotel.com

# SMTP server port (587 with STARTTLS)
EMAIL_PORT=587

# SMTP username / sender account email
EMAIL_USER=bookings@sbmhotel.com

# SMTP password of the CyberPanel mailbox bookings@sbmhotel.com (NEVER expose to frontend)
EMAIL_PASSWORD=your_cyberpanel_mailbox_password

# From display header
EMAIL_FROM=bookings@sbmhotel.com

# Administrator email for receiving instant new booking notifications
ADMIN_EMAIL=sbmhotel@gmail.com

# =========================================================================
# BHASHSMS WHATSAPP SERVICE ENVIRONMENT VARIABLES (SERVER-SIDE ONLY)
# =========================================================================
# Official BhashSMS WhatsApp API Endpoint (e.g. https://api.bhashsms.com/api/v1/whatsapp/send)
BHASHSMS_API_URL=https://api.bhashsms.com/api/v1/whatsapp/send

# BhashSMS Registered Sender Name / WABA ID (e.g. SBMHTL)
BHASHSMS_SENDER_ID=SBMHTL

# BhashSMS Authentication: API Key (Preferred) or Username + Password
BHASHSMS_API_KEY=your_bhashsms_api_key
BHASHSMS_USER=your_bhashsms_username
BHASHSMS_PASSWORD=your_bhashsms_password

# BhashSMS WhatsApp Approved Template IDs (Optional / Template based)
BHASHSMS_OTP_TEMPLATE_ID=sbm_login_otp_v1
BHASHSMS_BOOKING_TEMPLATE_ID=sbm_booking_confirmation_v1



