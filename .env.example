# =========================================================================
# SBM HOTEL & GUEST HOUSE — MULTI-PROPERTY PAYMENT GATEWAY CONFIGURATION
# =========================================================================
# This file serves as a template for server-side environment variables.
# NEVER commit actual API keys or secret credentials to source control.
# Set these variables in your deployment platform environment settings
# (e.g., Cloud Run environment variables, Coolify, Vercel, or server .env).

# -------------------------------------------------------------------------
# GLOBAL APPLICATION SETTINGS
# -------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="https://sbmhotel.com"
NODE_ENV="production" # Set to "production" to enforce strict credential validation and disable simulation fallbacks
ALLOW_PAYMENT_SIMULATION="false" # Set to "true" ONLY in local development/sandbox testing

# -------------------------------------------------------------------------
# SBM 1: SBM HOTEL (Primary Property — Main Temple Road, Salasar)
# -------------------------------------------------------------------------
# Supported Providers: razorpay | phonepe | cashfree | stripe
SBM1_PAYMENT_GATEWAY_PROVIDER=razorpay
SBM1_MERCHANT_ID=SBM_HOTEL_1_MERCHANT
SBM1_BANK_ACCOUNT_NAME="SBM Hotel Salasar Current A/C (HDFC Bank)"
SBM1_SETTLEMENT_ACCOUNT_NUMBER="50200084920101"

# Provider API Credentials (Razorpay / PhonePe / Cashfree / Stripe)
SBM1_GATEWAY_KEY_ID=your_sbm1_key_id_here
SBM1_GATEWAY_KEY_SECRET=your_sbm1_key_secret_here
SBM1_GATEWAY_WEBHOOK_SECRET=your_sbm1_webhook_secret_here

# -------------------------------------------------------------------------
# SBM 2: SBM 2 GUEST HOUSE (Secondary Property — Approach Road, Salasar)
# -------------------------------------------------------------------------
# Supported Providers: razorpay | phonepe | cashfree | stripe
SBM2_PAYMENT_GATEWAY_PROVIDER=razorpay
SBM2_MERCHANT_ID=SBM_GUEST_HOUSE_2_MERCHANT
SBM2_BANK_ACCOUNT_NAME="SBM 2 Guest House Current A/C (ICICI Bank)"
SBM2_SETTLEMENT_ACCOUNT_NUMBER="10480500938472"

# Provider API Credentials (Razorpay / PhonePe / Cashfree / Stripe)
SBM2_GATEWAY_KEY_ID=your_sbm2_key_id_here
SBM2_GATEWAY_KEY_SECRET=your_sbm2_key_secret_here
SBM2_GATEWAY_WEBHOOK_SECRET=your_sbm2_webhook_secret_here

# =========================================================================
# EMAIL & WHATSAPP NOTIFICATIONS (SERVER-SIDE ONLY)
# =========================================================================
EMAIL_HOST=sbmhotel.com
EMAIL_PORT=587
EMAIL_USER=bookings@sbmhotel.com
EMAIL_PASSWORD=your_cyberpanel_mailbox_password
EMAIL_FROM=bookings@sbmhotel.com
ADMIN_EMAIL=sbmhotel@gmail.com

BHASHSMS_API_URL=https://api.bhashsms.com/api/v1/whatsapp/send
BHASHSMS_SENDER_ID=SBMHTL
BHASHSMS_API_KEY=your_bhashsms_api_key
BHASHSMS_OTP_TEMPLATE_ID=sbm_login_otp_v1
BHASHSMS_BOOKING_TEMPLATE_ID=sbm_booking_confirmation_v1
